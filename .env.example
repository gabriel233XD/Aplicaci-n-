# Copia este archivo como .env.local y completa los valores de tu proyecto de Supabase
# (Supabase → Project Settings → API).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Pon "true" solo si activaste el inicio con Google en Supabase (Authentication → Providers).
VITE_AUTH_GOOGLE=false

# Solo en el servidor (Vercel → Settings → Environment Variables). Nunca la pongas en el código.
# ANTHROPIC_API_KEY=
# TUTOR_MODEL=claude-haiku-5-5
